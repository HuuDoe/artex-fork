# Local overrides — copy to docker-compose.override.yml and adjust paths.
# This file is .gitignored; docker-compose.override.yml.example is tracked.
services:
  artex:
    network_mode: "service:dind"
    depends_on:
      postgres:
        condition: service_healthy
      dind:
        condition: service_healthy
    environment:
      ARTEX_PG_DSN: postgres://artex:${POSTGRES_PASSWORD}@postgres:5432/artex?sslmode=disable
      # Devin CLI needs XDG_DATA_HOME to find credentials.toml
      PATH: /usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin:/host-devin/bin
      XDG_DATA_HOME: /host-devin/data-parent
    volumes:
      # Devin CLI binary (read-only)
      - ${DEVIN_CLI_BIN:-${HOME}/.local/share/devin/cli/_versions/current/bin}:/host-devin/bin:ro
      # Devin data dir (credentials.toml lives here)
      - ${DEVIN_DATA_DIR:-${HOME}/.local/share/devin}:/host-devin/data-parent/devin
